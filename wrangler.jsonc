{
  // Configurazione Cloudflare Workers.
  //
  // Non c'e' "run_worker_first": non serve. Il comportamento predefinito e'
  // gia' quello giusto — Cloudflare prova prima a servire un file statico e
  // richiama il Worker solo se nessun file corrisponde. Poiche' /api/home non
  // e' un file, la richiesta arriva qui. Ometterlo evita anche di dipendere
  // da una versione recente di Wrangler.
  "name": "portafoglio-forex",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./sito",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
